  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Darkness Inside - \u044D\u0442\u043E \u0438\u0433\u0440\u0430, \u0433\u0434\u0435
    \u0432\u0430\u043C \u043F\u0440\u0435\u0434\u0441\u0442\u043E\u0438\u0442 \u043F\u0440\u043E\u044F\u0432\u0438\u0442\u044C
    \u0441\u043E\u043E\u0431\u0440\u0430\u0437\u0438\u0442\u0435\u043B\u044C\u043D\u043E\u0441\u0442\u044C,
    \u0432\u043E\u043E\u0431\u0440\u0430\u0436\u0435\u043D\u0438\u0435 \u0438 \u0445\u043E\u0440\u043E\u0448\u0443\u044E
    \u0440\u0435\u0430\u043A\u0446\u0438\u044E. \u0412\u0430\u043C \u043D\u0443\u0436\u043D\u043E
    \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442\u044C \u0443\u0440\u043E\u0432\u043D\u0438,
    \u043D\u0430 \u043A\u043E\u0442\u043E\u0440\u044B\u0445 \u043D\u0443\u0436\u043D\u043E
    \u0431\u0443\u0434\u0435\u0442 \u0440\u0430\u0437\u0433\u0430\u0434\u044B\u0432\u0430\u0442\u044C
    \u043E\u043F\u0440\u0435\u0434\u0435\u043B\u0435\u043D\u043D\u044B\u0435 \u0437\u0430\u0433\u0430\u0434\u043A\u0438
    \u0434\u043B\u044F \u043F\u0440\u043E\u0434\u0432\u0438\u0436\u0435\u043D\u0438\u044F
    \u043D\u0430 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u043F\u0430\u0440\u0430\u043B\u043B\u0435\u043B\u044C\u043D\u043E \u0441\u043E\u0432\u043C\u0435\u0449\u0430\u044F
    \u044D\u043B\u0435\u043C\u0435\u043D\u0442\u0430 \u0433\u0435\u0439\u043C\u043F\u043B\u0435\u044F
    \u043F\u043B\u0430\u0442\u0444\u043E\u0440\u043C\u0435\u0440\u0430! \u041F\u0440\u0438\u044F\u0442\u043D\u043E\u0439
    \u0438\u0433\u0440\u044B!\n\n\u0420\u0430\u0437\u0440\u0430\u0431\u043E\u0442\u0447\u0438\u043A:
    \u0411\u043E\u0436\u0438\u043A \u041C\u0430\u043A\u0441\u0438\u043C. "
  m_isRightToLeft: 0
