    generateMipmaps: 0
    androidMaxSize: 1024
    androidFormat: 50
  - name: UI
    pathPrefix: Assets/Art/UI
    generateMipmaps: 0
    androidMaxSize: 2048
    androidFormat: 48
  - name: "\u0413\u043B\u0430\u0432\u043D\u044B\u0439 \u0433\u0435\u0440\u043E\u0439
      (\u0430\u043D\u0438\u043C\u0430\u0446\u0438\u0438)"
