  textureRules:
  - name: "\u041C\u0438\u0440: \u0431\u043B\u043E\u043A\u0438, \u0434\u0432\u0435\u0440\u0438,
      \u0440\u044B\u0447\u0430\u0433\u0438, \u043F\u0440\u0435\u0434\u043C\u0435\u0442\u044B"
    pathPrefix: Assets/Art
    generateMipmaps: 0
    androidMaxSize: 1024
    androidFormat: 50
  - name: "\u0424\u043E\u043D\u044B"
    pathPrefix: Assets/Art/Background
    generateMipmaps: 0
    androidMaxSize: 1024
    androidFormat: 50
  - name: "\u0424\u043E\u043D \u043C\u0435\u043D\u044E \u043F\u0430\u0443\u0437\u044B"
